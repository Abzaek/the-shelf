# Copy to .env.local for development. In production these are read from
# /home/opc/apps/the-shelf/shelf.env by deploy/ecosystem.config.cjs.

# Where the SQLite database and uploaded files live.
SHELF_DATA_DIR=./.data
# Required in production: >= 32 random characters. `openssl rand -base64 48`
SHELF_SESSION_SECRET=
# Whole-store cap (bytes). Default 10 GB.
SHELF_TOTAL_QUOTA_BYTES=10737418240
# Per-account cap (bytes). Default 50 MB.
SHELF_USER_QUOTA_BYTES=52428800
# "open" (anyone can sign up) or "closed".
SHELF_REGISTRATION=open

# Email (Resend). Without a key, emails are printed to the server log and
# accounts start verified. With a key, new accounts must confirm their email.
RESEND_API_KEY=
SHELF_EMAIL_FROM="The Shelf <shelf@abzaek.dev>"
SHELF_APP_URL=http://localhost:3000
# Force on/off regardless of RESEND_API_KEY: true | false
# SHELF_REQUIRE_EMAIL_VERIFICATION=true

# Optional Drive integration. Core reading works without these.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_PROJECT_NUMBER=
# 32 random bytes in base64; encrypts refresh tokens. Back up securely.
SHELF_TOKEN_ENCRYPTION_KEY=
