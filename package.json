{
  "name": "the-shelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:analytics": "node scripts/analytics.test.cjs",
    "test:sync": "node scripts/sync.test.cjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm check:architecture && pnpm check:format && pnpm typecheck && pnpm exec eslint src && pnpm test:sync && pnpm test:analytics && pnpm test:community",
    "test:e2e": "playwright test",
    "check:format": "prettier --check \"src/lib/{sync,drive,storage/local}/**/*.ts\" \"src/server/{sync,drive}/**/*.ts\" \"src/components/offline/**/*.tsx\" \"src/app/api/{sync,uploads,drive}/**/*.ts\" tests/browser playwright.config.ts scripts/browser-test-server.mjs \"src/{lib,server,components}/community/**/*.{ts,tsx}\" src/app/api/community/route.ts",
    "test:community": "node scripts/community.test.cjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@serwist/turbopack": "^9.5.12",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "dexie": "4.4.2",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0",
    "rxdb": "^17.5.0",
    "serwist": "^9.5.12",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
